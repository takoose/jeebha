rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basic Helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    // Helper to get current user role safely
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'customer');
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserRole() == 'admin';
    }

    // Default: Allow all authenticated reads to unblock demo
    match /{document=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Specific rules for users (extra safety)
    match /users/{userId} {
      allow get, list, create: if isSignedIn();
      allow update: if isOwner(userId) || isAdmin();
    }

    // specific rules for shops/products
    match /shops/{shopId} {
      allow read: if true;
    }
    match /products/{productId} {
      allow read: if true;
    }
  }
}
